[submodule "ext/ogre-source"]
	path = ext/ogre-source
	# Fork of OGRECave/ogre carrying the YARS detached-ManualObject guard
	# (commit e99519a on branch yars-patches, one commit atop upstream
	# v14.5.2-79/922f5b6). Upstream lacks that commit, so CI checkout of
	# the submodule must fetch from the fork. See
	# docs/planning/v0.8.7-open-points.md.
	url = https://github.com/kzahedi/ogre.git
[submodule "ext/bullet-source"]
	path = ext/bullet-source
	url = https://github.com/bulletphysics/bullet3.git
