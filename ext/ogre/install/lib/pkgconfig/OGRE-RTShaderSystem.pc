prefix=/Volumes/Eregion/projects/yars/ext/ogre/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: OGRE-RTShaderSystem
Description: Real time shader generation component for OGRE
Version: 14.4.1
Requires: OGRE = 14.4.1
Libs: -L${libdir} -lOgreRTShaderSystem
Cflags: -I${includedir}/OGRE/RTShaderSystem -pthread
