prefix=/Volumes/Eregion/projects/yars/ext/ogre/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: OGRE-Paging
Description: General purpose paging component for OGRE
Version: 14.4.1
Requires: OGRE = 14.4.1
Libs: -L${libdir} -lOgrePaging
Cflags: -I${includedir}/OGRE/Paging -pthread
