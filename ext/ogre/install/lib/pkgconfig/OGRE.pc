prefix=/Volumes/Eregion/projects/yars/ext/ogre/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include
plugindir=${prefix}/lib/OGRE

Name: OGRE
Description: Object-Oriented Graphics Rendering Engine
Version: 14.4.1
URL: http://www.ogre3d.org
Libs: -L${libdir} -lOgreMain  -lpthread
Cflags: -I${includedir}/OGRE -pthread
