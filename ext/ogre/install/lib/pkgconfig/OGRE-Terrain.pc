prefix=/Volumes/Eregion/projects/yars/ext/ogre/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: OGRE-Terrain
Description: Outdoor terrain component for OGRE
Version: 14.4.1
Requires: OGRE = 14.4.1 , OGRE-Paging = 14.4.1
Libs: -L${libdir} -lOgreTerrain
Cflags: -I${includedir}/OGRE/Terrain -pthread
